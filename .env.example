# Copy to .env and fill in the key and model before starting a game.
# The program automatically reads this project-local file; no mock/fallback mode.
# Existing process environment wins; UTF-8 BOM is supported; no interpolation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro

# Optional transport settings. Redirects are disabled.
OPENAI_TIMEOUT_SECONDS=60
# Retry transient connection/response failures twice (3 total attempts per turn).
OPENAI_MAX_RETRIES=2
# Exponential backoff: 2s, 4s by default; each wait is capped at 30s.
OPENAI_RETRY_DELAY_SECONDS=2
# Requests run sequentially in speaking order.
OPENAI_MAX_TOKENS=2400
# Some OpenAI models require max_completion_tokens instead of max_tokens.
OPENAI_TOKEN_LIMIT_FIELD=max_tokens
OPENAI_JSON_MODE=true
# DeepSeek-specific option; leave empty when switching to a different provider.
DEEPSEEK_THINKING=disabled

# Supported aliases, when the corresponding OPENAI_* value is empty/unset:
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_API_URL=              # A full /chat/completions URL is also accepted.
# LLM_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# PYTHON_DOTENV_DISABLED=1
